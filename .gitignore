# 掘金签到插件 - Git忽略文件

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器文件
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# 临时文件
*.tmp
*.temp
*.log

# Node.js
node_modules/
npm-debug.log
yarn-error.log
yarn.lock

# 注意：package-lock.json 需提交，GitHub Actions 的 npm ci 依赖它锁定版本
# 之前被忽略会导致 CI 每次装到不同的 playwright 版本

# Chrome Extension 打包文件
*.zip
*.crx

# 用户数据（不要提交个人配置）
*.user.json
config.local.json

# 备份文件
*.bak
*.backup
*~

# 测试文件
test/
*.test.js
coverage/
docs/

# e2e / 分析脚本产物
analysis-output/

# 仅为方便本地跳转而建的软链接（真实文件在 scripts/ 和 .github/workflows/）
/checkin.mjs
/checkin.yml
/diagnose-post.mjs

# 扩展签名私钥：manifest.json 里的 key 是它的公钥，用于固定扩展 ID（跨设备同步依赖）。
# 私钥只在打包 .crx 时用，绝不提交；公钥已内联在 manifest.json，克隆仓库即可复用同一 ID。
.keys/