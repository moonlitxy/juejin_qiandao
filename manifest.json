{
    "manifest_version": 3,
    "name": "掘金自动签到",
    "version": "1.0.0",
    "description": "自动完成掘金技术博客网站的每日签到",
    "permissions": [
        "storage",
        "alarms",
        "notifications",
        "tabs"
    ],
    "host_permissions": [
        "https://juejin.cn/*",
        "https://*.juejin.cn/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://juejin.cn/*", "https://*.juejin.cn/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "options.html",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
